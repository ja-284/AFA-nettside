---
import { site } from '../../config/site';
import Accordion from '../ui/Accordion.astro';
---
<section class="section tone-cream" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-head stack" style="--stack: 1.25rem">
      <p class="eyebrow" data-reveal>Spørsmål og svar</p>
      <h2 id="faq-title" class="title" data-reveal style="--i: 1">Lurer du på noe?</h2>
      <p class="muted" data-reveal style="--i: 2">Finner du ikke svaret? <a href="/kontakt/">Send oss en melding</a>, så svarer vi.</p>
    </div>
    <Accordion items={site.faq} />
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
  }
  @media (min-width: 1000px) {
    .faq-grid {
      grid-template-columns: 0.9fr 1.3fr;
      align-items: start;
    }
    .faq-head {
      position: sticky;
      top: calc(var(--header-h) + 32px);
    }
  }
  .faq-head a {
    color: var(--coral-strong);
  }
</style>
