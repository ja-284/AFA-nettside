---
import { site } from '../../config/site';
import Photo from '../ui/Photo.astro';
import SectionHead from '../ui/SectionHead.astro';

const cards = [
  {
    key: 'reels' as const,
    tag: `${site.trial.lengthMin}–${site.trial.lengthMax} sek`,
    title: 'Reels',
    text: 'Korte videoer som får folk til å stoppe opp. Filmet stående, klippet i takt og tekstet, så de fungerer også uten lyd.',
  },
  {
    key: 'photos' as const,
    tag: 'Klare for feeden',
    title: 'Bilder',
    text: 'Ekte bilder av maten, produktene, lokalene og folkene deres. Til sosiale medier, nettsiden og menyen.',
  },
  {
    key: 'local' as const,
    tag: site.areas.core.join(' · '),
    title: 'Lokalt',
    text: 'Vi bor her. Vi kjenner nabolaget og kundene deres, og vi er aldri lenger unna enn en sykkeltur.',
  },
];
---
<section class="section tone-cream" aria-labelledby="hva-vi-gjor" id="hva-vi-gjor-seksjon">
  <div class="container">
    <SectionHead eyebrow="Hva vi gjør" title={site.tagline} id="hva-vi-gjor" split lead="Vi kommer til dere, filmer og fotograferer, redigerer alt selv og leverer ferdige filer. Dere trenger bare å trykke «del»." />
    <ul class="wwd-grid">
      {cards.map((c, i) => (
        <li class="card lift wwd-card" data-reveal style={`--i: ${i}`}>
          <Photo slot={c.key} class="wwd-photo" sizes="(min-width: 900px) 30vw, 90vw" widths={[480, 720, 960]} label={false} />
          <div class="wwd-body">
            <span class="chip">{c.tag}</span>
            <h3 class="wwd-title">{c.title}</h3>
            <p class="muted">{c.text}</p>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .wwd-grid {
    display: grid;
    gap: clamp(16px, 2vw, 28px);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 900px) {
    .wwd-grid {
      grid-template-columns: repeat(3, 1fr);
    }
    .wwd-card:nth-child(2) {
      margin-top: clamp(32px, 5vw, 80px);
    }
    .wwd-card:nth-child(3) {
      margin-top: clamp(64px, 10vw, 160px);
    }
  }
  .wwd-card {
    display: grid;
    padding: 10px;
    overflow: hidden;
  }
  .wwd-card :global(.wwd-photo) {
    --photo-radius: calc(var(--radius-lg) - 6px);
    aspect-ratio: 5 / 4 !important;
  }
  .wwd-body {
    display: grid;
    gap: 0.85rem;
    justify-items: start;
    padding: clamp(18px, 2.4vw, 30px) clamp(14px, 2vw, 24px) clamp(18px, 2vw, 26px);
  }
  .wwd-title {
    font-size: clamp(2.4rem, 1.6rem + 2.8vw, 4rem);
    font-weight: 800;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
  }
</style>
