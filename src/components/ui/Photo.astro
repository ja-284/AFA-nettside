---
/**
 * Viser et ekte bilde hvis filen finnes i src/assets/photos/ (eller team/portfolio),
 * ellers en pen plassholder i riktig format. Se src/config/images.ts.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { images, type ImageKey, type Tone } from '../../config/images';
import Icon from './Icon.astro';

interface Props {
  slot?: ImageKey;
  /** Alternativt: filnavn i en av bildemappene + egne verdier. */
  file?: string;
  folder?: 'photos' | 'team' | 'portfolio';
  alt?: string;
  ratio?: string;
  tone?: Tone;
  sizes?: string;
  widths?: number[];
  eager?: boolean;
  label?: string | false;
  class?: string;
  parallax?: boolean;
}

const files = {
  photos: import.meta.glob<ImageMetadata>('/src/assets/photos/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' }),
  team: import.meta.glob<ImageMetadata>('/src/assets/team/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' }),
  portfolio: import.meta.glob<ImageMetadata>('/src/assets/portfolio/*.{jpg,jpeg,png,webp,avif}', { eager: true, import: 'default' }),
};

const p = Astro.props;
const conf = p.slot ? images[p.slot] : undefined;
const folder = p.folder ?? 'photos';
const file = p.file ?? conf?.file ?? '';
const src = file ? files[folder][`/src/assets/${folder}/${file}`] : undefined;
const ratio = p.ratio ?? conf?.ratio ?? '4:5';
const [rw, rh] = ratio.split(':').map(Number);
const alt = p.alt ?? conf?.alt ?? '';
const tone = p.tone ?? conf?.tone ?? 'warm';
const sizes = p.sizes ?? '(min-width: 1280px) 600px, (min-width: 768px) 50vw, 100vw';
const widths = p.widths ?? [480, 720, 960, 1280, 1600];
const label = p.label === false ? '' : (p.label ?? `${ratio} · bilde kommer`);
---
<div class:list={['photo', p.class]} style={`aspect-ratio: ${rw} / ${rh}`} data-parallax-wrap={p.parallax ? '' : undefined}>
  {src ? (
    <Picture
      src={src}
      alt={alt}
      formats={['avif', 'webp']}
      widths={widths.filter((w) => w <= src.width)}
      sizes={sizes}
      loading={p.eager ? 'eager' : 'lazy'}
      fetchpriority={p.eager ? 'high' : undefined}
      decoding="async"
      class="photo-img"
      data-parallax={p.parallax ? '' : undefined}
    />
  ) : (
    <div class="ph photo-img" data-tone={tone} aria-hidden="true" data-parallax={p.parallax ? '' : undefined}></div>
  )}
  {!src && label && <span class="ph-label" aria-hidden="true"><Icon name="camera" size={14} />{label}</span>}
</div>

<style>
  .photo {
    position: relative;
    overflow: hidden;
    border-radius: var(--photo-radius, var(--radius-lg));
    background: var(--mist-2);
  }
  .photo :global(.photo-img),
  .photo :global(picture),
  .photo :global(img) {
    width: 100%;
    height: 100%;
  }
  .photo :global(img) {
    object-fit: cover;
  }
  .photo :global([data-parallax]) {
    height: 118%;
    margin-top: -9%;
  }
  .photo :global(picture[data-parallax]) :global(img) {
    height: 100%;
  }
</style>
