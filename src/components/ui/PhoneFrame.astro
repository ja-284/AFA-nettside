---
/** Telefonramme i 9:16 – motivet for reels. Innholdet legges i slotten. */
interface Props {
  class?: string;
  tilt?: number;
  label?: string;
}
const { class: cls, tilt = 0, label } = Astro.props;
---
<div class:list={['phone', cls]} style={tilt ? `--tilt: ${tilt}deg` : undefined} role={label ? 'img' : undefined} aria-label={label}>
  <div class="phone-screen">
    <slot />
  </div>
  <span class="phone-island" aria-hidden="true"></span>
</div>

<style>
  .phone {
    --w: clamp(200px, 22vw, 300px);
    position: relative;
    width: var(--w);
    aspect-ratio: 9 / 19.2;
    padding: calc(var(--w) * 0.035);
    border-radius: calc(var(--w) * 0.16);
    background: linear-gradient(160deg, #1d3a46, #071a22 55%, #12313d);
    box-shadow:
      inset 0 0 0 1.5px rgb(255 255 255 / 0.12),
      inset 0 0 0 calc(var(--w) * 0.012) #0b2530,
      0 40px 80px -30px rgb(11 37 48 / 0.55),
      0 18px 30px -18px rgb(11 37 48 / 0.4);
    transform: rotate(var(--tilt, 0deg));
  }
  .phone-screen {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: calc(var(--w) * 0.125);
    background: var(--navy);
    isolation: isolate;
  }
  .phone-island {
    position: absolute;
    top: calc(var(--w) * 0.07);
    left: 50%;
    width: 30%;
    height: calc(var(--w) * 0.085);
    border-radius: 999px;
    background: #050f14;
    translate: -50% 0;
    z-index: 3;
  }
</style>
