---
import Button from './ui/Button.astro';
interface Props {
  title?: string;
  text?: string;
}
const { title = 'Skal vi lage noe sammen?', text = 'Første prøve er gratis. Tre klipp, ingen forpliktelser – og dere bestemmer hva som vises.' } = Astro.props;
---
<section class="section tone-dark final-cta" aria-labelledby="cta-title">
  <div class="blobs" aria-hidden="true">
    <span class="blob" style="--c: rgb(217 72 43 / 0.55); --size: 60vmax; top: -30%; right: -20%; --t: 26s"></span>
    <span class="blob" style="--c: rgb(27 138 156 / 0.6); --size: 55vmax; bottom: -35%; left: -18%; --t: 30s; --dx: -6%"></span>
  </div>
  <div class="grain" aria-hidden="true"></div>
  <div class="container cta-inner">
    <h2 id="cta-title" class="display cta-title" data-reveal>{title}</h2>
    <p class="lead cta-lead" data-reveal style="--i: 1">{text}</p>
    <div class="btn-row" data-reveal style="--i: 2">
      <Button href="/bestill/?pakke=prove" size="lg" magnetic>Bestill gratis prøve</Button>
      <Button href="/kontakt/" variant="ghost" size="lg" icon="chat">Send oss en melding</Button>
    </div>
  </div>
</section>

<style>
  .final-cta {
    overflow: hidden;
    padding-block: clamp(110px, 16vw, 240px);
  }
  .cta-inner {
    position: relative;
    display: grid;
    gap: clamp(24px, 3vw, 40px);
    justify-items: start;
  }
  .cta-title {
    font-size: clamp(3rem, 0.8rem + 9vw, 10rem);
    max-width: 12ch;
  }
  .cta-lead {
    color: var(--on-dark-soft);
  }
</style>
