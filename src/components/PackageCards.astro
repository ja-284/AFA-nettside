---
import { formatPrice, site } from '../config/site';
import Button from './ui/Button.astro';
import Icon from './ui/Icon.astro';

interface Props {
  headingLevel?: 'h2' | 'h3';
}
const { headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
---
<ul class="pkg-grid">
  {site.packages.map((p, i) => (
    <li class:list={['card', 'lift', 'pkg', p.highlight && 'pkg-highlight']} data-reveal style={`--i: ${i}`}>
      {p.badge && <span class="badge pkg-badge">{p.badge}</span>}
      <H class:list={['pkg-name', p.badge && 'has-badge']}>{p.name}</H>
      <p class="pkg-tagline">{p.tagline}</p>
      <p class="pkg-price">
        <span class:list={['pkg-amount', p.price === null && 'is-text']}>{formatPrice(p)}</span>
        {p.unit && p.price !== null && <span class="pkg-unit">{p.unit}</span>}
      </p>
      <ul class="pkg-features">
        {p.features.map((f) => (
          <li><Icon name="check" size={18} />{f}</li>
        ))}
      </ul>
      <Button href={`/bestill/?pakke=${p.id}`} variant={p.highlight ? 'light' : p.price === 0 ? 'primary' : 'ghost'} class="pkg-cta" magnetic={p.highlight}>{p.cta}</Button>
    </li>
  ))}
</ul>

<style>
  .pkg-grid {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 960px) {
    .pkg-grid {
      grid-template-columns: repeat(3, 1fr);
      align-items: stretch;
    }
  }
  .pkg {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: clamp(26px, 3vw, 40px);
  }
  .pkg-highlight {
    --ink: var(--cream);
    --ink-soft: var(--on-dark-soft);
    --line: rgb(247 244 239 / 0.16);
    --focus: var(--sun);
    color: var(--cream);
    background:
      radial-gradient(100% 70% at 100% 0%, rgb(27 138 156 / 0.55), transparent 60%),
      radial-gradient(80% 60% at 0% 100%, rgb(217 72 43 / 0.25), transparent 60%),
      var(--navy);
    box-shadow: var(--shadow-lg);
  }
  @media (min-width: 960px) {
    .pkg-highlight {
      transform: translateY(-14px);
    }
    .pkg-highlight.lift:hover {
      transform: translateY(-20px);
    }
  }
  .pkg-badge {
    position: absolute;
    top: clamp(20px, 2.4vw, 30px);
    right: clamp(20px, 2.4vw, 30px);
  }
  .pkg-name {
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 0.95;
    text-transform: uppercase;
  }
  .pkg-name.has-badge {
    padding-right: 6.5rem;
  }
  .pkg-tagline {
    color: var(--ink-soft);
  }
  .pkg-price {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 0.6rem;
    padding-block: 1rem;
    border-block: 1px solid var(--line);
  }
  .pkg-amount {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 1.2rem + 1.2vw, 2.2rem);
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .pkg-amount.is-text {
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    line-height: 1.2;
  }
  .pkg-unit {
    color: var(--ink-soft);
  }
  .pkg-features {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    margin-bottom: 0.75rem;
    list-style: none;
  }
  .pkg-features li {
    display: flex;
    gap: 0.65rem;
    align-items: flex-start;
    line-height: 1.45;
  }
  .pkg-features :global(svg) {
    flex: none;
    margin-top: 0.15em;
    color: var(--teal-ink);
  }
  .pkg-highlight .pkg-features :global(svg) {
    color: var(--mint);
  }
  .pkg :global(.pkg-cta) {
    margin-top: auto;
    width: 100%;
  }
</style>
