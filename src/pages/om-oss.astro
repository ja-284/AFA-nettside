---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Photo from '../components/ui/Photo.astro';
import Icon from '../components/ui/Icon.astro';
import SectionHead from '../components/ui/SectionHead.astro';
import FinalCta from '../components/FinalCta.astro';
import { site } from '../config/site';

const crumbs = [
  { name: 'Hjem', href: '/' },
  { name: 'Om oss', href: '/om-oss/' },
];
const values = [
  { icon: 'eye' as const, title: 'Ærlighet', text: 'Vi sier hva vi kan, og hva vi ikke kan. Vi viser bare ekte arbeid og ekte vurderinger.' },
  { icon: 'bolt' as const, title: 'Tempo', text: 'Vi svarer raskt, møter opp når vi har sagt og leverer det vi har lovet.' },
  { icon: 'pin' as const, title: 'Lokalt', text: 'Vi bor her og vil at bedriftene rundt oss skal lykkes. Det er nabolaget vårt også.' },
  { icon: 'spark' as const, title: 'Kreativitet', text: 'Vi prøver nye vinkler, nye formater og nye idéer – og tar med oss det som fungerer.' },
];
const how = [
  { title: 'Vi starter med å lytte', text: 'Før vi filmer noe, prater vi om hva dere vil vise og hvem dere vil nå.' },
  { title: 'Vi er godt forberedt', text: 'Vi lager en enkel plan for hva vi skal filme, så filmøkten blir kort og effektiv.' },
  { title: 'Vi tar hensyn', text: 'Vi spør før vi filmer ansatte eller kunder, og vi holder oss unna når det er travelt.' },
  { title: 'Dere har siste ord', text: 'Ingenting publiseres uten at dere har sett det og sagt ja.' },
];
const placeholderName = (name: string) => !name || /^navn kommer$/i.test(name.trim());
const initials = (name: string) => name.split(/\s+/).map((w) => w[0]).slice(0, 2).join('').toUpperCase();
---
<BaseLayout title="Om oss" description={`Møt gruppen bak ${site.name}: elever på Fornebu som lager reels og bilder for lokale bedrifter gjennom valgfaget «${site.course}».`} og="om-oss" crumbs={crumbs}>
  <PageHero eyebrow="Om oss" title="Unge, lokale og nysgjerrige" lead={`Vi er en gruppe elever som driver ${site.name} gjennom valgfaget «${site.course}». Vi lager korte videoer og bilder for bedriftene rundt oss – og vi lærer noe nytt hver gang.`} crumbs={crumbs} />

  <section class="section tone-cream" aria-labelledby="historien" style="padding-top: 0">
    <div class="container story-grid">
      <div data-reveal>
        <Photo slot="filming" ratio="4:5" parallax sizes="(min-width: 900px) 45vw, 90vw" />
      </div>
      <div class="stack prose" style="--stack: 1.25rem">
        <p class="eyebrow" data-reveal>Historien</p>
        <h2 id="historien" class="title-md" data-reveal style="--i: 1">Hvorfor vi startet</h2>
        <p data-reveal style="--i: 2">Vi så at mange av bedriftene rundt oss på Fornebu, Snarøya og Lysaker har mye fint å vise frem: god mat, flinke folk og fine lokaler. Samtidig er det få som har tid til å filme, redigere og legge ut noe hver uke.</p>
        <p data-reveal style="--i: 3">Vi bruker sosiale medier hver dag og vet hva som får folk til å stoppe opp. Så vi tenkte: Hva om vi gjorde det for dem?</p>
        <p data-reveal style="--i: 4">Gjennom valgfaget «{site.course}» fikk vi muligheten til å starte en ekte bedrift. Vi er ikke et byrå, og vi later ikke som vi er det. Vi filmer med mobil, redigerer selv og gjør vårt beste hver gang. Derfor starter vi alltid med en gratis prøve.</p>
      </div>
    </div>
  </section>

  <section class="section tone-mist" aria-labelledby="verdier">
    <div class="container">
      <SectionHead eyebrow="Det vi står for" title="Fire verdier" id="verdier" split lead="De bestemmer hvordan vi jobber, hva vi sier ja til – og hva vi sier nei til." />
      <ul class="values">
        {values.map((v, i) => (
          <li class="card lift value" data-reveal style={`--i: ${i}`}>
            <span class="value-icon"><Icon name={v.icon} size={26} /></span>
            <h3 class="value-title">{v.title}</h3>
            <p class="muted">{v.text}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tone-cream" aria-labelledby="teamet">
    <div class="container">
      <SectionHead eyebrow="Teamet" title="Møt gruppen" id="teamet" split lead="Vi har hver vår rolle, men alle er med på det meste – fra idé til ferdig klipp." />
      <ul class="team">
        {site.team.map((m, i) => (
          <li class="member" data-reveal style={`--i: ${i}`}>
            {m.image ? (
              <Photo file={m.image} folder="team" ratio="4:5" alt={`Portrett av ${m.name}`} sizes="(min-width: 1000px) 25vw, 50vw" widths={[320, 480, 640]} />
            ) : (
              <div class="member-ph" aria-hidden="true">
                {placeholderName(m.name) ? (
                  <svg viewBox="0 0 24 24" width="56" height="56" fill="none" stroke="currentColor" stroke-width="1.4"><circle cx="12" cy="9" r="4" /><path d="M4.5 20.5c1.2-3.6 4.2-5.5 7.5-5.5s6.3 1.9 7.5 5.5" /></svg>
                ) : (
                  <span>{initials(m.name)}</span>
                )}
              </div>
            )}
            <div class="member-body">
              <h3 class="member-name">{m.name}</h3>
              <p class="member-role">{m.role}</p>
              <p class="muted small">{m.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section tone-dark" aria-labelledby="slik-jobber-vi">
    <div class="grain" aria-hidden="true"></div>
    <div class="container">
      <SectionHead eyebrow="Slik jobber vi" title="Enkelt for dere" id="slik-jobber-vi" split lead="Vi vil at det skal være lett å si ja – og lett å fortsette." />
      <ol class="how-list">
        {how.map((h, i) => (
          <li data-reveal style={`--i: ${i}`}>
            <span class="how-n">0{i + 1}</span>
            <h3>{h.title}</h3>
            <p>{h.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <FinalCta title="Vil dere jobbe med oss?" />
</BaseLayout>

<style>
  .story-grid {
    display: grid;
    gap: clamp(36px, 6vw, 96px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .story-grid {
      grid-template-columns: 1fr 1.1fr;
    }
  }
  .values,
  .team,
  .how-list {
    display: grid;
    gap: clamp(16px, 2vw, 24px);
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .values,
    .team,
    .how-list {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1080px) {
    .values,
    .team,
    .how-list {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  .value {
    display: grid;
    gap: 0.8rem;
    align-content: start;
    padding: clamp(24px, 3vw, 34px);
  }
  .value-icon {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 18px;
    background: var(--mist);
    color: var(--teal-ink);
  }
  .value-title {
    font-size: var(--text-xl);
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .member {
    display: grid;
    gap: 1rem;
    align-content: start;
  }
  .member-ph {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    background:
      radial-gradient(60% 50% at 50% 38%, rgb(255 255 255 / 0.7), transparent 70%),
      linear-gradient(160deg, var(--mist-2), #d5e4e8);
    color: var(--petrol);
  }
  .member-ph span {
    display: grid;
    place-items: center;
    width: 42%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--white);
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.4vw, 2.2rem);
    font-weight: 800;
    box-shadow: var(--shadow-sm);
  }
  .member-name {
    font-size: var(--text-lg);
    font-weight: 750;
  }
  .member-role {
    color: var(--coral-strong);
    font-weight: 620;
    font-size: var(--text-sm);
  }
  .member-body {
    display: grid;
    gap: 0.3rem;
  }
  .how-list li {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding-top: 1.4rem;
    border-top: 1.5px solid var(--line-strong);
  }
  .how-n {
    color: var(--sun);
    font-weight: 700;
    font-family: var(--font-display);
  }
  .how-list h3 {
    font-size: var(--text-xl);
    font-weight: 750;
    letter-spacing: -0.03em;
  }
  .how-list p {
    color: var(--on-dark-soft);
  }
</style>
