{
  "name": "afa-videos",
  "version": "1.0.0",
  "description": "Nettsiden til AFA Videos",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/postbuild.mjs",
    "preview": "wrangler pages dev --port 8788",
    "check": "astro check && tsc -p functions/tsconfig.json",
    "lint": "eslint .",
    "db:migrate:local": "wrangler d1 migrations apply afa-videos --local",
    "db:migrate:remote": "wrangler d1 migrations apply afa-videos --remote",
    "deploy": "npm run build && wrangler pages deploy",
    "icons": "node scripts/generate-icons.mjs",
    "check:config": "node scripts/check-config.mjs",
    "check:links": "node scripts/check-links.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "license": "UNLICENSED",
  "dependencies": {
    "@astrojs/sitemap": "^3.7.6",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "astro": "^7.4.13",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@cloudflare/workers-types": "^5.20261123.1",
    "@eslint/js": "^10.0.1",
    "@fontsource/bricolage-grotesque": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "globals": "^17.14.0",
    "lighthouse": "^13.6.0",
    "qrcode": "^1.5.4",
    "satori": "^0.63.2",
    "sharp": "^0.35.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "wrangler": "^4.166.0"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  }
}
